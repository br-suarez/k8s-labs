# The version everyone writes first. It works, and it ships a compiler toolchain
# to production.
#
# Four separate problems, none of which produce an error:
#   1. `node:22` is the full Debian image — apt, python3, gcc, git, ~1.1 GB.
#   2. `npm install` installs devDependencies too, so esbuild ships to prod.
#   3. `COPY . .` before the install means ANY source change invalidates the
#      npm layer and reinstalls every dependency.
#   4. It runs as root.
FROM node:22

WORKDIR /app

# Copying everything first is what kills the cache: edit one line of
# src/server.js and npm install runs again from scratch.
COPY . .

RUN npm install
RUN npm run build

EXPOSE 3000
CMD ["node", "dist/server.js"]
